EASIER_BANKING_CLOUD_FAILURE_THRESHOLD=3
EASIER_BANKING_CLOUD_CIRCUIT_SECONDS=60
EASIER_BANKING_SESSION_TTL_SECONDS=28800
EASIER_BANKING_LOGIN_MAX_FAILURES=5
EASIER_BANKING_LOGIN_FAILURE_WINDOW_SECONDS=300
EASIER_BANKING_LOGIN_LOCK_SECONDS=300
