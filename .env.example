# 评委开箱即用演示模式。生产部署必须改为 0，并接入真实 OTP 通道。
DEMO_MODE=1

# 可选覆盖；如需禁用内置评委体验网关，可显式设置为空。
# EASIER_BANKING_GATEWAY_URL=
# EASIER_BANKING_GATEWAY_APP_SECRET=

EASIER_BANKING_CLOUD_RATE_LIMIT=20
